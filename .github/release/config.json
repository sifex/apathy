{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "apathy",
      "include-component-in-tag": false,
      "version-file": ".github/release/version.txt",
      "changelog-path": ".github/release/CHANGELOG.md",
      "bump-minor-pre-major": true,
      "extra-files": [
        { "type": "generic", "path": "apathy.plugin.zsh" },
        { "type": "generic", "path": ".github/release/apathy.zsh" },
        { "type": "generic", "path": "README.md" }
      ]
    }
  }
}
